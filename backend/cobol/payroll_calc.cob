LINKAGE SECTION.
01 LS-INPUT-DATA.
   05 LS-CURRENCY        PIC X(03).
   05 LS-BASE-SALARY-STR PIC X(15).
   05 LS-ALLOWANCES-STR  PIC X(15).
   05 LS-FX-RATE-STR     PIC X(15).
   05 LS-NSIF-FLAG       PIC X(01).
   05 LS-VERSION         PIC X(08).
01 LS-OUTPUT-DATA.
   05 LS-GROSS-STR       PIC X(15).
   05 LS-NSIF-EMP-STR    PIC X(15).
   05 LS-NSIF-CO-STR     PIC X(15).
   05 LS-TAXABLE-STR     PIC X(15).
   05 LS-PIT-STR         PIC X(15).
   05 LS-NET-STR         PIC X(15).
   05 LS-STATUS          PIC X(02).

PROCEDURE DIVISION USING LS-INPUT-DATA LS-OUTPUT-DATA.
MAIN-PROCEDURE.
    MOVE "00" TO LS-STATUS
    MOVE 0 TO WS-GROSS-SDG WS-NSIF-EMP WS-NSIF-CO WS-TAXABLE WS-PIT WS-NET
    *> Validate numeric strings — NUMVAL raises EC-ARGUMENT on non-numeric
    IF FUNCTION TRIM(LS-BASE-SALARY-STR) = SPACES OR FUNCTION TRIM(LS-ALLOWANCES-STR) = SPACES OR FUNCTION TRIM(LS-FX-RATE-STR) = SPACES
        MOVE "01" TO LS-STATUS
        GOBACK
    END-IF
    COMPUTE WS-BASE-SALARY = FUNCTION NUMVAL(LS-BASE-SALARY-STR)
        ON SIZE ERROR MOVE "01" TO LS-STATUS GOBACK END-COMPUTE
    COMPUTE WS-ALLOWANCES = FUNCTION NUMVAL(LS-ALLOWANCES-STR)
        ON SIZE ERROR MOVE "01" TO LS-STATUS GOBACK END-COMPUTE
    COMPUTE WS-FX-RATE = FUNCTION NUMVAL(LS-FX-RATE-STR)
        ON SIZE ERROR MOVE 1 TO WS-FX-RATE END-COMPUTE
    IF WS-FX-RATE <= 0
        MOVE 1 TO WS-FX-RATE
    END-IF
    *> 1. Gross SDG — FX to SDG if not SDG, else sum
    IF LS-CURRENCY = "SDG" OR LS-CURRENCY = "sdg"
        COMPUTE WS-GROSS-SDG = WS-BASE-SALARY + WS-ALLOWANCES
            ON SIZE ERROR MOVE "02" TO LS-STATUS GOBACK END-COMPUTE
    ELSE
        COMPUTE WS-GROSS-SDG = (WS-BASE-SALARY + WS-ALLOWANCES) * WS-FX-RATE
            ON SIZE ERROR MOVE "02" TO LS-STATUS GOBACK END-COMPUTE
    END-IF
    *> 2. NSIF — only if eligible Y, ROUNDED at statutory points
    IF LS-NSIF-FLAG = "Y" OR LS-NSIF-FLAG = "y"
        COMPUTE WS-NSIF-EMP ROUNDED = WS-GROSS-SDG * WS-NSIF-EMP-RATE
            ON SIZE ERROR MOVE 0 TO WS-NSIF-EMP END-COMPUTE
        COMPUTE WS-NSIF-CO ROUNDED = WS-GROSS-SDG * WS-NSIF-CO-RATE
            ON SIZE ERROR MOVE 0 TO WS-NSIF-CO END-COMPUTE
    ELSE
        MOVE 0 TO WS-NSIF-EMP WS-NSIF-CO
    END-IF
    *> 3. Taxable — floor 0
    IF WS-GROSS-SDG > WS-NSIF-EMP
        COMPUTE WS-TAXABLE = WS-GROSS-SDG - WS-NSIF-EMP
    ELSE
        MOVE 0 TO WS-TAXABLE
    END-IF
    *> 4. PIT progressive — exempt 50k, then 5/10/15/20
    IF WS-TAXABLE <= WS-TAX-FREE-LIMIT
        MOVE 0 TO WS-PIT
    ELSE
        COMPUTE WS-REMAINING = WS-TAXABLE - WS-TAX-FREE-LIMIT
        MOVE 0 TO WS-PIT
        MOVE WS-TAX-FREE-LIMIT TO WS-PREV-LIMIT
        PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 4
            MOVE WS-LIMIT(IDX) TO WS-CUR-LIMIT
            MOVE WS-RATE(IDX) TO WS-CUR-RATE
            COMPUTE WS-BRACKET-AMT = WS-CUR-LIMIT - WS-PREV-LIMIT
            IF WS-REMAINING <= 0
                EXIT PERFORM
            END-IF
            IF WS-REMAINING > WS-BRACKET-AMT
                COMPUTE WS-PIT = WS-PIT + WS-BRACKET-AMT * WS-CUR-RATE
                COMPUTE WS-REMAINING = WS-REMAINING - WS-BRACKET-AMT
            ELSE
                COMPUTE WS-PIT = WS-PIT + WS-REMAINING * WS-CUR-RATE
                MOVE 0 TO WS-REMAINING
            END-IF
            MOVE WS-CUR-LIMIT TO WS-PREV-LIMIT
        END-PERFORM
        COMPUTE WS-PIT ROUNDED = WS-PIT
            ON SIZE ERROR MOVE 0 TO WS-PIT END-COMPUTE
    END-IF
    *> 5. Net
    COMPUTE WS-NET = WS-GROSS-SDG - WS-NSIF-EMP - WS-PIT
        ON SIZE ERROR MOVE 0 TO WS-NET END-COMPUTE
    *> 6. Format to strings — edited Z...9.99 then TRIM
    MOVE WS-GROSS-SDG TO WS-GROSS-DISP
    MOVE WS-NSIF-EMP TO WS-NSIF-EMP-DISP
    MOVE WS-NSIF-CO TO WS-NSIF-CO-DISP
    MOVE WS-TAXABLE TO WS-TAXABLE-DISP
    MOVE WS-PIT TO WS-PIT-DISP
    MOVE WS-NET TO WS-NET-DISP
    MOVE FUNCTION TRIM(WS-GROSS-DISP) TO LS-GROSS-STR
    MOVE FUNCTION TRIM(WS-NSIF-EMP-DISP) TO LS-NSIF-EMP-STR
    MOVE FUNCTION TRIM(WS-NSIF-CO-DISP) TO LS-NSIF-CO-STR
    MOVE FUNCTION TRIM(WS-TAXABLE-DISP) TO LS-TAXABLE-STR
    MOVE FUNCTION TRIM(WS-PIT-DISP) TO LS-PIT-STR
    MOVE FUNCTION TRIM(WS-NET-DISP) TO LS-NET-STR
    GOBACK.
